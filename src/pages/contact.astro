---
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Contact Us | Legal Rights Explained</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: Georgia, serif; background: #f0f4f8; }
      header { background: #1a3a5c; padding: 28px 20px; text-align: center; border-bottom: 3px solid #c9a84c; }
      .header-tag { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #c9a84c; margin-bottom: 6px; font-family: Arial, sans-serif; }
      header h1 { font-size: 1.6rem; color: white; font-weight: normal; }
      nav { background: #152d47; display: flex; justify-content: center; gap: 28px; padding: 10px; }
      nav a { color: #a8c4e0; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; font-family: Arial, sans-serif; }
      nav a:hover { color: #c9a84c; }
      main { max-width: 760px; margin: 36px auto; padding: 0 16px; }
      .card { background: white; border-radius: 12px; padding: 36px; box-shadow: 0 4px 20px rgba(0,0,0,0.07); border: 0.5px solid #dde3ea; margin-bottom: 16px; }
      .page-title { font-size: 1.4rem; color: #1a3a5c; margin-bottom: 6px; }
      .subtitle { font-size: 14px; color: #aaa; margin-bottom: 28px; font-family: Arial, sans-serif; border-bottom: 0.5px solid #eee; padding-bottom: 16px; }
      h2 { color: #1a3a5c; margin: 24px 0 8px; font-family: Arial, sans-serif; letter-spacing: 0.5px; text-transform: uppercase; font-size: 12px; }
      p { color: #555; line-height: 1.9; font-size: 14px; margin-bottom: 8px; }
      label { display: block; font-size: 12px; color: #666; margin-bottom: 5px; font-family: Arial, sans-serif; letter-spacing: 0.5px; text-transform: uppercase; }
      input, textarea, select { width: 100%; border: 0.5px solid #dde3ea; border-radius: 8px; padding: 10px 12px; font-size: 14px; color: #333; background: #f8fafc; margin-bottom: 16px; font-family: Georgia, serif; }
      input:focus, textarea:focus, select:focus { outline: none; border-color: #c9a84c; }
      textarea { resize: none; height: 120px; }
      button { width: 100%; background: #1a3a5c; color: white; border: none; padding: 13px; border-radius: 8px; font-size: 14px; font-weight: bold; cursor: pointer; font-family: Arial, sans-serif; letter-spacing: 0.5px; transition: background 0.2s; }
      button:hover { background: #c9a84c; }
      .info-boxes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 24px; }
      .info-box { background: #f8fafc; border: 0.5px solid #dde3ea; border-radius: 10px; padding: 18px; text-align: center; }
      .info-icon { font-size: 1.4rem; margin-bottom: 6px; }
      .info-title { font-size: 12px; font-weight: bold; color: #1a3a5c; font-family: Arial, sans-serif; margin-bottom: 4px; }
      .info-text { font-size: 12px; color: #888; font-family: Arial, sans-serif; }
      .success { display: none; background: #f0faf5; border: 0.5px solid #c9a84c; border-radius: 8px; padding: 16px; text-align: center; color: #1a3a5c; font-family: Arial, sans-serif; font-size: 14px; margin-top: 16px; }
      .error { display: none; background: #fff0f0; border: 0.5px solid #ffaaaa; border-radius: 8px; padding: 16px; text-align: center; color: #cc0000; font-family: Arial, sans-serif; font-size: 14px; margin-top: 16px; }
      footer { text-align: center; color: #aaa; font-size: 12px; padding: 28px; font-family: Arial, sans-serif; }
      footer a { color: #aaa; margin: 0 8px; }
    </style>
  </head>
  <body>
    <header>
      <div class="header-tag">⚖ US Legal Information</div>
      <h1>Legal Rights Explained</h1>
    </header>
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/contact">Contact</a>
    </nav>
    <main>
      <div class="card">
        <h1 class="page-title">Contact Us</h1>
        <p class="subtitle">We'd love to hear from you</p>

        <div class="info-boxes">
          <div class="info-box">
            <div class="info-icon">📧</div>
            <div class="info-title">Email</div>
            <div class="info-text">We respond within 24 hours</div>
          </div>
          <div class="info-box">
            <div class="info-icon">⚖️</div>
            <div class="info-title">Legal Info</div>
            <div class="info-text">General questions only</div>
          </div>
          <div class="info-box">
            <div class="info-icon">🔒</div>
            <div class="info-title">Private</div>
            <div class="info-text">Your message stays private</div>
          </div>
        </div>

        <h2>Send Us a Message</h2>

        <label>Your Name</label>
        <input type="text" id="nameInput" placeholder="John Smith" />

        <label>Your Email</label>
        <input type="email" id="emailInput" placeholder="john@example.com" />

        <label>Subject</label>
        <select id="subjectSelect">
          <option value="">-- Select a subject --</option>
          <option>General Question</option>
          <option>Report an Issue</option>
          <option>Feedback or Suggestion</option>
          <option>Privacy Concern</option>
          <option>Other</option>
        </select>

        <label>Your Message</label>
        <textarea id="messageInput" placeholder="Type your message here..."></textarea>

        <button id="submitBtn">Send Message</button>

        <div class="success" id="successMsg">
          ✅ Thank you! Your message has been received. We will get back to you within 24 hours.
        </div>
        <div class="error" id="errorMsg">
          ❌ Something went wrong. Please try again.
        </div>

        <p style="margin-top:20px; font-size:12px; color:#aaa; font-family:Arial,sans-serif;">
          ⚠ Please note: We cannot provide specific legal advice. For legal advice specific to your situation, please consult a licensed attorney in your state.
        </p>
      </div>
    </main>

    <footer>
      <p>© 2026 LegalRightsExplained.com — Not a substitute for professional legal advice</p>
      <p style="margin-top:8px;">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/contact">Contact</a>
      </p>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('submitBtn').addEventListener('click', async function() {
          var name = document.getElementById('nameInput').value;
          var email = document.getElementById('emailInput').value;
          var subject = document.getElementById('subjectSelect').value;
          var message = document.getElementById('messageInput').value;
          var btn = document.getElementById('submitBtn');
          var successMsg = document.getElementById('successMsg');
          var errorMsg = document.getElementById('errorMsg');

          if (!name) { alert('Please enter your name!'); return; }
          if (!email) { alert('Please enter your email!'); return; }
          if (!subject) { alert('Please select a subject!'); return; }
          if (!message) { alert('Please type your message!'); return; }

          btn.textContent = 'Sending...';
          btn.disabled = true;
          successMsg.style.display = 'none';
          errorMsg.style.display = 'none';

          try {
            var response = await fetch('https://formspree.io/f/mvznzvkr', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: name,
                email: email,
                subject: subject,
                message: message
              })
            });

            if (response.ok) {
              successMsg.style.display = 'block';
              document.getElementById('nameInput').value = '';
              document.getElementById('emailInput').value = '';
              document.getElementById('subjectSelect').value = '';
              document.getElementById('messageInput').value = '';
            } else {
              errorMsg.style.display = 'block';
            }
          } catch (err) {
            errorMsg.style.display = 'block';
          }

          btn.textContent = 'Send Message';
          btn.disabled = false;
        });
      });
    </script>

  </body>
</html>