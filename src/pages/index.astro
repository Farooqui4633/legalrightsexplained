    <script>
      function setQuestion(q) {
        document.getElementById('questionInput').value = q;
      }

      document.getElementById('askButton').addEventListener('click', async function() {
        var state = document.getElementById('stateSelect').value;
        var question = document.getElementById('questionInput').value;
        var answerBox = document.getElementById('answerBox');
        var answerContent = document.getElementById('answerContent');

        if (!state) { alert('Please select your state first!'); return; }
        if (!question) { alert('Please type your legal question!'); return; }

        answerBox.style.display = 'block';
        answerContent.innerHTML = '<p class="loading">Finding your answer, please wait...</p>';

        try {
          var response = await fetch('/api/ask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: question, state: state })
          });

          var data = await response.json();
          var text = data.choices[0].message.content;

          if (text) {
            var clean = text
              .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
              .replace(/\n\n/g, '</p><p>')
              .replace(/\n/g, '<br>');
            answerContent.innerHTML = '<p>' + clean + '</p>';
          } else {
            answerContent.innerHTML = '<p>Sorry could not get an answer. Please try again.</p>';
          }

        } catch (error) {
          answerContent.innerHTML = '<p>Sorry something went wrong. Please try again.</p>';
        }
      });
    </script>
